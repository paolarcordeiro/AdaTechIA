def gerar_resposta(prompt: str, modelo: str) -> str:

    reposta = client.models.generate_content(

        model=modelo,

        contents=prompt,

        config=types.GenerateContentConfig(

            temperature=0.0,

            system_instruction=instrucoes_ex1

            )

    )

 

    return reposta.text

 

