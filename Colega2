from pathlib import Path
import os

from dotenv import load_dotenv
from google import genai
from google.genai import types


# =========================
# 1. Carregar arquivo .env
# =========================

env_path = Path(__file__).with_name(".env")
dotenv_carregado = load_dotenv(dotenv_path=env_path, override=True)

api_key = os.getenv("GEMINI_API_KEY")

print("Arquivo .env encontrado/carregado?", dotenv_carregado)
print("GEMINI_API_KEY carregada?", api_key is not None)
print("Tamanho da chave:", len(api_key or ""))

if not api_key:
    raise ValueError(
        "GEMINI_API_KEY não foi carregada. "
        "Verifique se existe um arquivo .env na mesma pasta do script "
        "e se ele contém: GEMINI_API_KEY=sua_chave"
    )


# =========================
# 2. Inicializar cliente
# =========================

client = genai.Client(api_key=api_key)

modelo = "gemini-3.1-flash-lite"


# =========================
# 3. Exercício 1
# =========================

prompt_ex1 = "Organize as informações do texto fornecido em JSON."

review_ex1 = (
    "O produto funciona bem, mas o manual de instruções poderia ser mais claro. "
    "No geral, é razoável."
)

instrucoes_ex1 = """
Você é um padronizador de dados de texto em JSON.

Sua tarefa é converter feedbacks de clientes em um JSON estrito com exatamente estas chaves:
- cliente
- sentimento
- categoria

Regras:
- Responda somente com o JSON.
- Não escreva explicações.
- Não use Markdown.
- Não crie chaves extras.
- Se o nome do cliente não aparecer, use "Anônimo".
- O campo sentimento deve ser apenas: "Positivo", "Neutro" ou "Negativo".
- O campo categoria deve indicar o principal assunto do feedback.

Utilize o seguinte padrão:

Entrada:
"O prazo de entrega foi cumprido certinho e o produto veio bem embalado. Muito satisfeito com a compra!"
Saída:
{"cliente": "Anônimo", "sentimento": "Positivo", "categoria": "Entrega"}

Entrada:
