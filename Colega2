schema_ex1 = {
    "type": "object",
    "properties": {
        "cliente": {
            "type": "string"
        },
        "sentimento": {
            "type": "string",
            "enum": ["Positivo", "Neutro", "Negativo"]
        },
        "categoria": {
            "type": "string"
        }
    },
    "required": ["cliente", "sentimento", "categoria"],
    "additionalProperties": False
}


