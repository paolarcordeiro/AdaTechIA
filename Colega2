import os
from dotenv import load_dotenv
from google import genai

# Carrega o arquivo .env
load_dotenv()

# Verifica se a chave existe
if not (os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY")):
    raise ValueError("API key não encontrada. Crie um .env com GEMINI_API_KEY=sua_chave_aqui")

# Cria o cliente
client = genai.Client()

modelo = "gemini-2.5-flash"


def executar(titulo, prompt):
    print(f"\n===== {titulo} =====")
    resposta = client.models.generate_content(
        model=modelo,
        contents=prompt
    )
    print(resposta.text)


